{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Keel",
  "scopeName": "source.keel",
  "fileTypes": [
    "kl"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#structs"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.keel",
          "match": "(//).*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.keel"
            }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.keel",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.keel",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.keel",
          "match": "(?<!\\.)[0-9]*\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.keel",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "constants": {
      "name": "constant.language.keel",
      "match": "\\b(true|false|null)\\b"
    },
    "types": {
      "name": "storage.type.keel",
      "match": "\\b(int|float|bool|string)\\b(?!\\()"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.keel",
          "match": "\\b(if|else|match|while|for|in|try|catch|return|break|continue|loop)\\b"
        },
        {
          "name": "keyword.control.import.keel",
          "match": "\\b(dylib|import|as)\\b"
        },
        {
          "name": "keyword.other.fn.keel",
          "match": "\\bfn\\b"
        },
        {
          "name": "keyword.declaration.struct.keel storage.type.keel",
          "match": "\\bstruct\\b"
        },
        {
          "name": "keyword.other.keel",
          "match": "\\blet\\b"
        }
      ]
    },
    "structs": {
      "match": "\\b(struct)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": {
          "name": "keyword.declaration.struct.keel storage.type.keel"
        },
        "2": {
          "name": "entity.name.type.keel"
        }
      }
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.other.fn.keel"
            },
            "2": {
              "name": "entity.name.function.keel"
            }
          }
        },
        {
          "name": "entity.name.function.keel",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.keel",
          "match": "(\\+=|-=|\\*=|/=|%=|\\^=)"
        },
        {
          "name": "keyword.operator.arrow.keel",
          "match": "(->|=>)"
        },
        {
          "name": "keyword.operator.range.keel",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.keel",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.keel",
          "match": "(\\|\\||&&|!)"
        },
        {
          "name": "keyword.operator.union.keel",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.arithmetic.keel",
          "match": "(\\+|-|\\*|/|%|\\^)"
        },
        {
          "name": "keyword.operator.assignment.keel",
          "match": "="
        },
        {
          "name": "keyword.operator.namespace.keel",
          "match": "::"
        },
        {
          "name": "punctuation.separator.dot.keel",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.colon.keel",
          "match": ":"
        },
        {
          "name": "punctuation.semicolon.keel",
          "match": ";"
        },
        {
          "name": "punctuation.comma.keel",
          "match": ","
        }
      ]
    }
  }
}